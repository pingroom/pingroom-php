{
    "name": "pingroom/pingroom",
    "description": "Official PHP SDK for the PingRoom agent API: send pings, ask a human to approve or answer, listen for replies, drive live cards, and verify webhook signatures.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pingroom",
        "notifications",
        "push",
        "agent",
        "webhook",
        "sdk"
    ],
    "homepage": "https://pingroom.io",
    "support": {
        "issues": "https://github.com/pingroom/pingroom-php/issues",
        "source": "https://github.com/pingroom/pingroom-php"
    },
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/polyfill-intl-normalizer": "^1.28"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "PingRoom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PingRoom\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse -c phpstan.tests.neon.dist --memory-limit=1G"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
